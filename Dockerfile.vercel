FROM dunglas/frankenphp:1-php8.4-bookworm AS base
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_mysql pdo_pgsql opcache bcmath \
    && printf 'memory_limit=256M\n' > "$PHP_INI_DIR/conf.d/zz-app.ini"
WORKDIR /app

FROM base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist
COPY . .
# A per-build key keeps APP_KEY out of version control. It is written as
# APP_KEY_FALLBACK so it still applies if the platform defines APP_KEY but
# leaves it blank. Set a real APP_KEY in Vercel to pin it across deploys.
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    bootstrap/cache \
    database \
    && printf 'APP_KEY_FALLBACK=base64:%s\n' "$(php -r 'echo base64_encode(random_bytes(32));')" > .env \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan event:cache \
    && php artisan view:cache \
    && touch database/database.sqlite \
    && php artisan migrate --force --no-interaction

FROM base AS runtime
COPY --from=dependencies /app /app
COPY Caddyfile /etc/frankenphp/Caddyfile
# Caddy writes its autosave and TLS storage under the XDG directories. Point
# them at the always-writable tmpfs so a read-only root cannot stop startup.
ENV XDG_CONFIG_HOME=/tmp \
    XDG_DATA_HOME=/tmp \
    PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_NAME="Milky Way Cosmetics Stores" \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
