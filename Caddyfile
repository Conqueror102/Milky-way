{
    auto_https off
    admin off

    # Vercel gives this container a single CPU (GOMAXPROCS=1 in the runtime log).
    # Keep the PHP thread pool small so it fits the container memory budget.
    frankenphp {
        num_threads 2
    }
}

:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    # PHP-free liveness probe. If this responds, the container and its HTTP
    # routing are healthy and any 500 elsewhere is coming from PHP.
    handle /__alive {
        respond "caddy-ok" 200
    }

    handle {
        php_server
    }
}
